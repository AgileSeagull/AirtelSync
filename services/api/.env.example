# Advisor LLM. Without any key the advisor runs in scripted (rule-based) mode.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest
# Alternatively Claude:
# ANTHROPIC_API_KEY=
# UDYAM_LLM_PROVIDER=gemini        # gemini | anthropic (default: whichever key is set, Gemini first)
# UDYAM_ADVISOR_MODE=scripted      # force scripted mode

